<launch>
	<arg name="fcu_url" default="/dev/ttyACM0:57600" />
	<arg name="gcs_url" default="" />
	<arg name="tgt_system" default="1" />
	<arg name="tgt_component" default="1" />
	<arg name="log_output" default="screen" />
	<arg name="fcu_protocol" default="v2.0" />
	<!-- Restart mavros_node when it dies (SIM path only: real Starlings use
	     px4_interface over uXRCE-DDS and never load this file). mavros's own
	     node.launch declares respawn_mavros but never wires it to its node, so
	     the node is declared here instead of included. 2026-10-20: mavros
	     segfaulted mid-flight twice in one day (robot_interface then saw stale
	     odometry and the commander lost the drone until a manual relaunch).
	     After a respawn PX4 is already on its offboard-loss failsafe (1 s) -
	     TROUBLESHOOTING "MAVROS died" for the two-command recovery.
	     respawn_delay is a literal on the node: launch (Jazzy) parses it as a
	     float and does not accept a $(var ...) substitution there. -->
	<arg name="respawn_mavros" default="true" />
	<arg name="namespace" default="mavros"/>

	<node pkg="mavros" exec="mavros_node" namespace="$(var namespace)" output="$(var log_output)"
	      respawn="$(var respawn_mavros)" respawn_delay="2.0">
		<param name="fcu_url" value="$(var fcu_url)" />
		<param name="gcs_url" value="$(var gcs_url)" />
		<param name="tgt_system" value="$(var tgt_system)" />
		<param name="tgt_component" value="$(var tgt_component)" />
		<param name="fcu_protocol" value="$(var fcu_protocol)" />
		<!-- load blacklist, config -->
		<param from="$(find-pkg-share mavros)/launch/px4_pluginlists.yaml" />
		<param from="$(find-pkg-share interface_bringup)/launch/px4_config.yaml" />
	</node>
</launch>
