#!/bin/sh
#
# @name ModalAI Starling 2 Max (Pegasus / Isaac Sim SITL)
#
# @type Quadrotor x
#
# Rotor geometry from CMU's sys-ID USD (body FLU: r0 +0.095,-0.13 | r1 -0.095,+0.13 |
# r2 +0.095,+0.13 | r3 -0.095,-0.13), written here in PX4 FRD (y negated).
# KM = k_m / k_f = 5.38697e-8 / 3.964738e-6 = 0.0136. Hover throttle 0.36 follows from the
# Pegasus rotor-speed ceiling (1450 rad/s) and k_f. Rate/position gains: rc.mc_defaults.
# Bind-mounted into PX4's ROMFS source airframes dir (ROMFS/px4fmu_common/init.d-posix/airframes) by
# simulation/isaac-sim/docker/docker-compose.yaml — Pegasus copies that tree into a temp root at SITL start.
#

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0

param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.095
param set-default CA_ROTOR0_PY 0.13
param set-default CA_ROTOR0_KM 0.0136
param set-default CA_ROTOR1_PX -0.095
param set-default CA_ROTOR1_PY -0.13
param set-default CA_ROTOR1_KM 0.0136
param set-default CA_ROTOR2_PX 0.095
param set-default CA_ROTOR2_PY -0.13
param set-default CA_ROTOR2_KM -0.0136
param set-default CA_ROTOR3_PX -0.095
param set-default CA_ROTOR3_PY 0.13
param set-default CA_ROTOR3_KM -0.0136

param set-default MPC_THR_HOVER 0.36

# Attitude / rate / position gains: the REAL Starling 1's values (starling_1_indoor_params.params,
# ModalAI tuning for this airframe). rc.mc_defaults (Iris gains) made the sim oscillate and run
# away on the first flights: with CMU's inertia (~15x below the Iris) and short arms the control
# effectiveness is ~7x higher, and the 72 ms motor lag adds phase.
param set-default MC_ROLLRATE_P 0.064
param set-default MC_ROLLRATE_I 0.1
param set-default MC_ROLLRATE_D 0.0013
param set-default MC_ROLLRATE_K 1.0
param set-default MC_PITCHRATE_P 0.064
param set-default MC_PITCHRATE_I 0.096
param set-default MC_PITCHRATE_D 0.0011
param set-default MC_PITCHRATE_K 1.0
param set-default MC_YAWRATE_P 0.07
param set-default MC_YAWRATE_I 0.5
param set-default MC_YAWRATE_D 0.0
param set-default MC_YAWRATE_K 1.0
param set-default MC_ROLL_P 8.0
param set-default MC_PITCH_P 8.0
param set-default MC_YAW_P 2.8
param set-default MPC_XY_P 0.95
param set-default MPC_Z_P 5.0
param set-default MPC_XY_VEL_P_ACC 1.8
param set-default MPC_Z_VEL_P_ACC 8.0
param set-default MPC_ACC_HOR_MAX 3.0
param set-default MPC_XY_VEL_MAX 3.0
param set-default THR_MDL_FAC 0.9

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
