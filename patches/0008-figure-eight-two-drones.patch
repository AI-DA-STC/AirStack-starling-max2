+            make_scenario('figure_eight', num_drones=n, nominal_speed=0.5,
+                          bounds=ARENA, safety_radius=0.55, seed=7,
+                          center=[0.0, 0.0, 2.0], intruder_start=[0.0, 0.0, 1.0])
