#usda 1.0
(
    "Construction-site arena for the SVG swarm sim. References the site + props from ./AI_training/Construction_site/Scene02_nohumans.usd (not the Meerkat robot, its OmniGraphs or its PhysicsScene). Site translated by (29.0, 12.5, -0.20) so the level clear patch at site (-29.0, -12.5) is the drones' origin at ground level. Generated by build_arena_usda.py."
    defaultPrim = "stage"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stage"
{
    def Xform "site"
    {
        double3 xformOp:translate = (29, 12.5, -0.20000000000000004)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "construction_site_withrobot" (
            prepend references = @./AI_training/Construction_site/Scene02_nohumans.usd@</World/construction_site_withrobot>
        )
        {
        }

        def Xform "Added_Assets" (
            prepend references = @./AI_training/Construction_site/Scene02_nohumans.usd@</World/Added_Assets>
        )
        {
        }
    }
}

