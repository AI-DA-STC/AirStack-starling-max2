# Sim-only (iron rule 9): one drone, teleop_single_ours.yaml, forward pushes through the teleop_frame relay (no keyboard, no safe_teleop).
# Read twice: sourced by tools/sim.sh (bash) and parsed by tools/lib/report.py (plain KEY=value) -- no inline comments, no $(...).
TITLE="one-drone teleop frame: a forward push follows the nose (Drive mode) and +X (Room mode)"
ISSUE=NEAR-789
MILESTONE=S5
PURPOSE="Show that a forward push on the stick moves the drone where its nose points in Drive mode, at headings 0, 90, 180 and 270, and along +X in Room mode. The relay turns the stick from the drone's frame into the room's frame before the commander sees it."
SCOPE="PX4's own sim state estimate positions the drone (no mocap, no camera); flat default world; one drone. The teleop_frame relay is in the loop. safe_teleop and the keyboard are NOT: fly.sh publishes on the relay's input topic /svg/drone_1/teleop_command_stick itself."
SIM_ONLY_LINE="none of these values is ported to the drone; the relay, the push speed and the gates are sim-only (iron rule 9)."
CONFIG=teleop_single_ours.yaml
SCENARIO=hover
BAG_PREFIX=teleop_frame
# DURATION_S = the settle time after each yaw, before the push (fly.sh argument 1, wall seconds).
DURATION_S=4
NUM_ROBOTS=1
# No Basestation Studio: the live plot window is the view.
USE_STUDIO=false
# FLY_ARGS = fly.sh arguments after the settle time: FRAC PUSH_S (push speed = FRAC x teleop_max_speed_mps, for PUSH_S s).
FLY_ARGS="0.25 2.0"
# sim.sh's watchdog on fly.sh (wall s): five yaws (<= 15 s each), five pushes and the takeoff and landing fit well inside it.
FLY_TIMEOUT_S=600
BASELINE="none (first run sets it)"
