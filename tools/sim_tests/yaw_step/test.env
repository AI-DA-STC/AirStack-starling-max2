# Sim-only (iron rule 9): one drone, teleop_single.yaml, yaw pulses through the commander's teleop input (no keyboard, no safe_teleop).
# Read twice: sourced by tools/sim.sh (bash) and parsed by tools/lib/report.py (plain KEY=value) -- no inline comments, no $(...).
TITLE="one-drone yaw-step: heading ring-down after a yaw pulse, PX4 vehicle time"
ISSUE=NEAR-789
MILESTONE=S5
PURPOSE="Measure how the sim drone's heading settles after a yaw pulse is released (overshoot, ring, settle time, swing-back rate, drift) from the PX4 ulog in vehicle time, so the sim airframe's yaw gains can be retuned; the keyboard sessions of 2026-10-30 showed a ±8–17° ring at ~0.8 Hz."
SCOPE="PX4's own sim state estimate positions the drone (no mocap, no camera); flat default world; one drone; commander teleop input only (safe_teleop and the keyboard not in the loop); time gates read PX4 vehicle time from the ulog."
SIM_ONLY_LINE="none of these values is ported to the drone; the sim airframe's yaw gains and any gain the sweep sets live are sim-only (iron rule 9)."
CONFIG=teleop_single.yaml
SCENARIO=hover
BAG_PREFIX=yaw_step
# DURATION_S = the wall-clock gap between pulses (fly.sh argument 1); vehicle gap = gap x time scale (~1.3 flat world).
DURATION_S=20
NUM_ROBOTS=1
# No Basestation Studio: the live plot window is the view (two Studio windows cost sim speed, 10-30).
USE_STUDIO=false
# FLY_ARGS = fly.sh arguments after the gap: N_PER_DIRECTION RATE_RAD_S PULSE_S [SWEEP]
#   each gain set flies N pulses each way (+,-,+,-,...); SWEEP = ';'-separated gain sets applied live over MAVROS
#   before sets 1..k, e.g. "MC_YAW_P=2.0;MC_YAW_P=1.4,MC_YAWRATE_D=0.002". Set 0 always flies the booted (airframe)
#   gains and is the only gated set. Every live change is logged to docs/record/<run>/changes.log (owner rule 2026-11-02).
FLY_ARGS="3 1.0 1.0"
# sim.sh's watchdog on fly.sh (wall s): a sweep set costs about 2 x N x (PULSE_S + gap) + 60 s of param pulls; raise it for long sweeps.
FLY_TIMEOUT_S=1500
BASELINE="keyboard sessions 2026-10-30 (sim_site_hand1/3 cuVSLAM replays): ±8–17° ring at ~0.8 Hz for ≥ 10 s; no ulog"
